#include <windows.h>
#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CORONA_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@CORONA_VERSION_TWEAK@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "@CORONA_COMPANY_NAME@\0"
            VALUE "FileDescription",  "@CORONA_FILE_DESCRIPTION@\0"
            VALUE "FileVersion",      "@CORONA_VERSION_STRING@\0"
            VALUE "InternalName",     "Corona_defect_detection\0"
            VALUE "LegalCopyright",   "@CORONA_LEGAL_COPYRIGHT@\0"
            VALUE "OriginalFilename", "Corona_defect_detection.dll\0"
            VALUE "ProductName",      "@CORONA_PRODUCT_NAME@\0"
            VALUE "ProductVersion",   "@CORONA_VERSION_STRING@\0"
            VALUE "Comments",         "@CORONA_COMMENTS@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
