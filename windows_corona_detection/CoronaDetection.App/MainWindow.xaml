<Window x:Class="CoronaDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corona 瑕疵检测工作站"
        Icon="/Assets/aa.png"
        Width="1460" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="#F3F6FA"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Corona 瑕疵检测工作站"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="检测任务 · 结果处理 · 结果分析 · 模型配置"
                               Margin="1,3,0,0" Foreground="#B7C7DA"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="EngineStatusText" Text="● 模型未初始化"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold" Foreground="#FFC107"/>
                    <TextBlock x:Name="VersionText" Text="版本 1.0.0"
                               Margin="0,4,0,0" HorizontalAlignment="Right"
                               Foreground="#B7C7DA" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="14">
            <TabItem Header="检测任务">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="任务设置">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="检测模式" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="SingleModeRadio" Content="单张检测" IsChecked="True"
                                             Margin="0,0,24,0" Checked="ModeRadio_Checked"/>
                                <RadioButton x:Name="BatchModeRadio" Content="批量检测"
                                             Checked="ModeRadio_Checked"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="图片格式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatCombo" Grid.Row="0" Grid.Column="3"/>

                            <TextBlock Grid.Row="1" Text="输入位置" VerticalAlignment="Center"/>
                            <TextBox x:Name="InputPathText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                     Margin="0,3,6,3"/>
                            <Button x:Name="BrowseInputButton" Grid.Row="1" Grid.Column="4"
                                    Content="选择图片…" Click="BrowseInput_Click"/>

                            <TextBlock Grid.Row="2" Text="结果目录" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutputPathText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                     Margin="0,3,6,3"/>
                            <Button Grid.Row="2" Grid.Column="4" Content="选择文件夹…"
                                    Click="BrowseOutput_Click"/>

                            <TextBlock Grid.Row="3" Text="批量选项" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="RecursiveCheck" Content="递归检测所有子文件夹"
                                          IsEnabled="False" Margin="0,0,28,0"/>
                                <CheckBox x:Name="PreserveTreeCheck" Content="按原文件夹层级保存"
                                          IsChecked="True" IsEnabled="False" Margin="0,0,28,0"/>
                                <CheckBox x:Name="SaveImagesCheck" Content="保存标注结果图" IsChecked="True"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="执行" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal">
                                <Button x:Name="StartButton" Content="开始检测" Click="Start_Click"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Width="110"/>
                                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
                                        IsEnabled="False" Width="88"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="2,2,2,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TaskStatusText" Text="等待任务"
                                   Grid.ColumnSpan="2" Foreground="#3F4752"/>
                        <ProgressBar x:Name="TaskProgress" Grid.Row="1" Height="19"
                                     Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="ProgressText" Grid.Row="1" Grid.Column="1"
                                   Text="等待任务" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <GroupBox Header="检测结果">
                            <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Results}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55"/>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="190"/>
                                    <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="65"/>
                                    <DataGridTextColumn Header="缺陷数" Binding="{Binding DefectCount}" Width="70"/>
                                    <DataGridTextColumn Header="推理耗时(ms)" Binding="{Binding InferenceMs, StringFormat=0.0}" Width="105"/>
                                    <DataGridTextColumn Header="图片保存耗时(ms)" Binding="{Binding SaveMs, StringFormat=0.0}" Width="125"/>
                                    <DataGridTextColumn Header="总耗时(ms)" Binding="{Binding TotalMs, StringFormat=0.0}" Width="95"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85"/>
                                    <DataGridTextColumn Header="错误信息" Binding="{Binding Error}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="结果处理">
                <TabControl Margin="6">
                    <TabItem Header="CSV 转 JSON">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="CSV 转 LabelMe JSON">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="42"/>
                                <RowDefinition Height="Auto" MinHeight="42"/>
                                <RowDefinition Height="Auto" MinHeight="46"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="缺陷明细 CSV" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConversionCsvPathText" Grid.Column="1"
                                     Margin="0,3,8,3"/>
                            <Button x:Name="BrowseConversionCsvButton" Grid.Column="2"
                                    Content="选择 details.csv…" Click="BrowseConversionCsv_Click"/>

                            <TextBlock Grid.Row="1" Text="JSON 输出目录" VerticalAlignment="Center"/>
                            <TextBox x:Name="ConversionOutputPathText" Grid.Row="1" Grid.Column="1"
                                     Margin="0,3,8,3"/>
                            <Button x:Name="BrowseConversionOutputButton" Grid.Row="1" Grid.Column="2"
                                    Content="选择文件夹…" Click="BrowseConversionOutput_Click"/>

                            <TextBlock Grid.Row="2" Text="执行" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StartConversionButton" Content="开始转换"
                                        Click="StartConversion_Click"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Width="110"/>
                                <CheckBox x:Name="OverwriteConversionFilesCheck"
                                          Content="覆盖同名 JSON" IsChecked="False"
                                          VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <Button x:Name="CancelConversionButton" Content="取消"
                                        Click="CancelConversion_Click" IsEnabled="False" Width="88"/>
                                <Button x:Name="OpenConversionOutputButton" Content="打开输出目录"
                                        Click="OpenConversionOutput_Click" Width="118"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="2,5,2,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConversionStatusText" Text="请选择检测生成的 details.csv"
                                   Grid.ColumnSpan="2" Foreground="#3F4752"/>
                        <ProgressBar x:Name="ConversionProgress" Grid.Row="1" Height="19"
                                     Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="ConversionProgressText" Grid.Row="1" Grid.Column="1"
                                   Text="等待转换" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="转换结果">
                        <DataGrid x:Name="ConversionResultGrid"
                                  ItemsSource="{Binding ConversionResults}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55"/>
                                <DataGridTextColumn Header="图片名称" Binding="{Binding ImageName}" Width="200"/>
                                <DataGridTextColumn Header="缺陷数" Binding="{Binding DefectCount}" Width="75"/>
                                <DataGridTextColumn Header="图片宽" Binding="{Binding ImageWidth}" Width="75"/>
                                <DataGridTextColumn Header="图片高" Binding="{Binding ImageHeight}" Width="75"/>
                                <DataGridTextColumn Header="JSON 路径" Binding="{Binding JsonPath}" Width="*"/>
                                <DataGridTextColumn Header="提示" Binding="{Binding Warning}" Width="280"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
                    </TabItem>

                    <TabItem Header="补齐空标注">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="62"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <GroupBox Header="按图片文件名补齐空 LabelMe JSON">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="42"/>
                                        <RowDefinition Height="Auto" MinHeight="42"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="原始图片文件夹" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CompletionImagePathText" Grid.Column="1"
                                             Margin="0,3,8,3"/>
                                    <Button x:Name="BrowseCompletionImageButton" Grid.Column="2"
                                            Content="选择文件夹…" Click="BrowseCompletionImage_Click"/>

                                    <TextBlock Grid.Row="1" Text="LabelMe JSON 文件夹" VerticalAlignment="Center"
                                               TextWrapping="NoWrap"/>
                                    <TextBox x:Name="CompletionJsonPathText" Grid.Row="1" Grid.Column="1"
                                             Margin="0,3,8,3"/>
                                    <Button x:Name="BrowseCompletionJsonButton" Grid.Row="1" Grid.Column="2"
                                            Content="选择文件夹…" Click="BrowseCompletionJson_Click"/>

                                    <TextBlock Grid.Row="2" Text="执行" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="StartCompletionButton" Content="扫描并补齐"
                                                Click="StartCompletion_Click"
                                                Background="{StaticResource PrimaryBrush}" Foreground="White"
                                                BorderThickness="0" Width="110"/>
                                        <CheckBox x:Name="RecursiveCompletionCheck"
                                                  Content="包含子文件夹" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="16,0,8,0"/>
                                        <Button x:Name="CancelCompletionButton" Content="取消"
                                                Click="CancelCompletion_Click" IsEnabled="False" Width="88"/>
                                        <Button x:Name="OpenCompletionOutputButton" Content="打开 JSON 文件夹"
                                                Click="OpenCompletionOutput_Click" Width="150"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Row="1" Margin="2,5,2,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompletionStatusText"
                                           Text="选择图片文件夹和 JSON 文件夹；按不含扩展名的文件名精确匹配"
                                           Grid.ColumnSpan="2" Foreground="#3F4752"/>
                                <ProgressBar x:Name="CompletionProgress" Grid.Row="1" Height="19"
                                             Minimum="0" Maximum="1"/>
                                <TextBlock x:Name="CompletionProgressText" Grid.Row="1" Grid.Column="1"
                                           Text="等待扫描" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <GroupBox Grid.Row="2" Header="本次补齐的空标注">
                                <DataGrid x:Name="CompletionResultGrid"
                                          ItemsSource="{Binding AnnotationCompletionResults}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55"/>
                                        <DataGridTextColumn Header="图片名称" Binding="{Binding ImageName}" Width="210"/>
                                        <DataGridTextColumn Header="图片宽" Binding="{Binding ImageWidth}" Width="75"/>
                                        <DataGridTextColumn Header="图片高" Binding="{Binding ImageHeight}" Width="75"/>
                                        <DataGridTextColumn Header="空标注 JSON 路径" Binding="{Binding JsonPath}" Width="*"/>
                                        <DataGridTextColumn Header="提示" Binding="{Binding Warning}" Width="260"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="结果分析">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="预测结果与 GT 对比">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="40"/>
                                <RowDefinition Height="Auto" MinHeight="48"/>
                                <RowDefinition Height="Auto" MinHeight="44"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="原始图片文件夹" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnalysisImagePathText" Grid.Column="1" Margin="0,3,8,3"/>
                            <Button x:Name="BrowseAnalysisImageButton" Grid.Column="2"
                                    Content="选择文件夹…" Click="BrowseAnalysisImage_Click"/>

                            <TextBlock Grid.Row="1" Text="预测 JSON 文件夹" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnalysisPredictionPathText" Grid.Row="1" Grid.Column="1" Margin="0,3,8,3"/>
                            <Button x:Name="BrowseAnalysisPredictionButton" Grid.Row="1" Grid.Column="2"
                                    Content="选择文件夹…" Click="BrowseAnalysisPrediction_Click"/>

                            <TextBlock Grid.Row="2" Text="GT JSON 文件夹" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnalysisGroundTruthPathText" Grid.Row="2" Grid.Column="1" Margin="0,3,8,3"/>
                            <Button x:Name="BrowseAnalysisGroundTruthButton" Grid.Row="2" Grid.Column="2"
                                    Content="选择文件夹…" Click="BrowseAnalysisGroundTruth_Click"/>

                            <TextBlock Grid.Row="3" Text="分析输出文件夹" VerticalAlignment="Center"/>
                            <TextBox x:Name="AnalysisOutputPathText" Grid.Row="3" Grid.Column="1" Margin="0,3,8,3"/>
                            <Button x:Name="BrowseAnalysisOutputButton" Grid.Row="3" Grid.Column="2"
                                    Content="选择文件夹…" Click="BrowseAnalysisOutput_Click"/>

                            <TextBlock Grid.Row="4" Text="预测标签规则" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="IgnorePredictionAbnormalCheck"
                                          Content="忽略预测 Abnormal" IsChecked="False"
                                          VerticalAlignment="Center" Margin="0,0,28,0"/>
                                <CheckBox x:Name="MapDarkClustersToStainCheck"
                                          Content="预测 DarkClusters 按 Stain 统计" IsChecked="False"
                                          VerticalAlignment="Center" Margin="0,0,28,0"/>
                                <TextBlock Text="规则仅作用于预测标签，并记录在 overall_metrics.csv"
                                           Foreground="#687384" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Text="匹配与执行" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="IoU 阈值" VerticalAlignment="Center"/>
                                <TextBox x:Name="AnalysisIouThresholdText" Text="0.5" Width="62"
                                         Margin="8,0,18,0" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="RecursiveAnalysisCheck" Content="包含子文件夹"
                                          IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <CheckBox x:Name="OverwriteAnalysisCheck" Content="覆盖已有分析结果"
                                          IsChecked="False" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <Button x:Name="StartAnalysisButton" Content="开始分析"
                                        Click="StartAnalysis_Click"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Width="105"/>
                                <Button x:Name="CancelAnalysisButton" Content="取消"
                                        Click="CancelAnalysis_Click" IsEnabled="False" Width="80"/>
                                <Button x:Name="OpenAnalysisOutputButton" Content="打开输出文件夹"
                                        Click="OpenAnalysisOutput_Click" Width="140"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="1" Margin="2,5,2,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AnalysisStatusText"
                                   Text="GT polygon 将转换为轴对齐最小外接矩形后进行一对一 IoU 匹配"
                                   Grid.ColumnSpan="2" Foreground="#3F4752"/>
                        <ProgressBar x:Name="AnalysisProgress" Grid.Row="1" Height="19"
                                     Minimum="0" Maximum="1"/>
                        <TextBlock x:Name="AnalysisProgressText" Grid.Row="1" Grid.Column="1"
                                   Text="等待分析" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <GroupBox Grid.Row="2" Header="逐图分析结果">
                        <DataGrid x:Name="AnalysisResultGrid"
                                  ItemsSource="{Binding AnalysisResults}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="图片名称" Binding="{Binding ImageName}" Width="180"/>
                                <DataGridTextColumn Header="GT" Binding="{Binding GroundTruthCount}" Width="50"/>
                                <DataGridTextColumn Header="预测" Binding="{Binding PredictionCount}" Width="50"/>
                                <DataGridTextColumn Header="TP" Binding="{Binding TruePositiveCount}" Width="50"/>
                                <DataGridTextColumn Header="漏检" Binding="{Binding MissedCount}" Width="55"/>
                                <DataGridTextColumn Header="误检" Binding="{Binding FalsePositiveCount}" Width="55"/>
                                <DataGridTextColumn Header="类别错误" Binding="{Binding MisclassifiedCount}" Width="70"/>
                                <DataGridTextColumn Header="Precision" Binding="{Binding Precision, StringFormat=0.000}" Width="75"/>
                                <DataGridTextColumn Header="Recall" Binding="{Binding Recall, StringFormat=0.000}" Width="70"/>
                                <DataGridTextColumn Header="F1" Binding="{Binding F1, StringFormat=0.000}" Width="65"/>
                                <DataGridTextColumn Header="Mean IoU" Binding="{Binding MeanIou, StringFormat=0.000}" Width="78"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="模型配置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="SaveConfigButton" Content="保存配置"
                                    Click="SaveConfig_Click"/>
                            <Button x:Name="RestartModelButton" Content="保存并重启模型"
                                    Click="RestartModel_Click" MinWidth="142"/>
                            <Button Content="重新读取" Click="ReloadConfig_Click"/>
                            <Button Content="选择模型文件…" Click="SelectModelPath_Click"
                                    MinWidth="130"/>
                        </StackPanel>
                        <TextBlock Text="配置修改后会标记为“待重启”；开始检测前会自动保存并重启模型。"
                                   Foreground="#687384" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DataGrid x:Name="ConfigGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding ConfigSettings}"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CellEditEnding="ConfigGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配置分组" Binding="{Binding Section}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参数" Binding="{Binding Key}" Width="240" IsReadOnly="True"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="310"/>
                            <DataGridTextColumn Header="说明" Binding="{Binding Comment}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
